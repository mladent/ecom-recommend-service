{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Controller Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "objective",
    "allowed_paths",
    "blocked_paths",
    "forbidden_regex",
    "required_commands"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "blocked_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_regex": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "coverage_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
