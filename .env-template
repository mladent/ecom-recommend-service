# Kaggle API Credentials
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Data Configuration
DATA_PATH=./data
RAW_DATA_FILE=data.csv
PROCESSED_DATA_FILE=processed_data.pkl

# Recommendation Engine Configuration
# use with data_full.csv from Kaggle; LLM normalization/enrichment set to false
MIN_SUPPORT=0.02
MIN_CONFIDENCE=0.5
MAX_BUNDLE_SIZE=5

# use for minimum dataset ~10%; when using LLMs for normalization/enrichment
# MIN_SUPPORT=0.000298
# MIN_CONFIDENCE=0.07

# Model Configuration
TRAIN_TEST_SPLIT=0.8
RANDOM_STATE=42
N_JOBS=-1

# LLM Normalization Configuration (cache-first)
LLM_NORMALIZATION_ENABLED=false
LLM_CACHE_FIRST=true
LLM_CACHE_PATH=./data/normalization_cache.json
LLM_ALIAS_MAP_PATH=./data/description_aliases.json
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=64
LLM_TIMEOUT_SECONDS=20

# LLM Category Enrichment Configuration (cache-first)
LLM_CATEGORY_ENRICHMENT_ENABLED=false
LLM_CATEGORY_CACHE_FIRST=true
LLM_CATEGORY_CACHE_PATH=./data/category_enrichment_cache.json
LLM_CATEGORY_BATCH_SIZE=10

# LLM Outlier Detection Configuration (batch + IQR)
LLM_OUTLIER_ENABLED=false
LLM_OUTLIER_CACHE_FIRST=true
LLM_OUTLIER_CACHE_PATH=./data/anomaly_cache.json
LLM_OUTLIER_OUTPUT_PATH=./data/suspicious_transactions.tsv
LLM_OUTLIER_BATCH_SIZE=50
LLM_OUTLIER_IQR_MULTIPLIER=1.5

# LLM Context Extraction Configuration (cache-first)
LLM_CONTEXT_ENABLED=false
LLM_CONTEXT_CACHE_FIRST=true
LLM_CONTEXT_CACHE_PATH=./data/context_extraction_cache.json
LLM_CONTEXT_MAX_CONTEXTS=3
LLM_CONTEXT_MIN_CONFIDENCE=0.6

# LLM Out-of-Stock Alternatives Configuration (cache-first)
LLM_OOS_ENABLED=false
LLM_OOS_CACHE_FIRST=true
LLM_OOS_CACHE_PATH=./data/out_of_stock_alternatives_cache.json
LLM_OOS_INVENTORY_PATH=./data/inventory.csv
LLM_OOS_MAX_ALTERNATIVES=1
LLM_OOS_MIN_SCORE=0.3

# Provider API keys and endpoints (keep commented unless used)
# OPENAI_API_KEY=your_openai_api_key

# AZURE_OPENAI_API_KEY=your_azure_openai_api_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name
# AZURE_OPENAI_API_VERSION=2024-06-01

# GEMINI_API_KEY=your_gemini_api_key

# ANTHROPIC_API_KEY=your_anthropic_api_key

# PERPLEXITY_API_KEY=your_perplexity_api_key
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
